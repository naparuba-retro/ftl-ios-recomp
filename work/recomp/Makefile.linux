# Build Linux (Steam Deck) du port FTL : make -f Makefile.linux -j4
# Sources : ../ (runtime) + genj/ (code genere). Sortie : ftl_linux
CC      ?= gcc
OPT     ?= -O2
CFLAGS  := $(OPT) -std=gnu17 -fno-strict-aliasing -fwrapv -ffp-contract=off -fno-delete-null-pointer-checks -fpermissive -w -pthread -I genj -I . $(shell sdl2-config --cflags)
LDLIBS  := $(shell sdl2-config --libs) -lGL -lm -ldl -pthread

GEN := $(wildcard genj/gen_*.c)
RT  := rt.c hle_libc.c hle_string.c hle_sys.c hle_sound.c hle_stream.c hle_thread.c hle_rbtree.c neon.c gl_host.c pvrtc.c main_game.c stubs.c
OBJ := $(patsubst %.c,obj/%.o,$(GEN) $(RT))

ftl_linux: $(OBJ)
	$(CC) -o $@ $(OBJ) $(LDLIBS)

stubs.c: make_stubs.py genj/gen_ext.h hle_libc.c hle_string.c hle_sys.c hle_sound.c hle_stream.c hle_thread.c hle_rbtree.c gl_host.c
	python3 make_stubs.py genj/gen_ext.h hle_libc.c hle_string.c hle_sys.c hle_sound.c hle_stream.c hle_thread.c hle_rbtree.c gl_host.c > stubs.c

obj/%.o: %.c plat.h rt.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf obj ftl_linux stubs.c
